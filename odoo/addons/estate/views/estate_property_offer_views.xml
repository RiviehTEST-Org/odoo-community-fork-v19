<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="estate_property_offer_view_list" model="ir.ui.view">
            <field name="name">Property Offers List View</field>
            <field name="model">estate.property.offer</field>
            <field name="arch" type="xml">
                <list string="Property Offers List">
                    <field name="price"/>
                    <field name="bidder_id"/>
                    <field name="status"/>
                </list>
            </field>
        </record>    

        <record id="estate_property_offer_view_form" model="ir.ui.view">
            <field name="name">Property Offers Form View</field>
            <field name="model">estate.property.offer</field>
            <field name="arch" type="xml">
                <form string="Property Offers Form">
                    <sheet>
                        <group>
                            <field name="price"/>
                            <field name="bidder_id"/>
                            <field name="status"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

    </data>
</odoo> 